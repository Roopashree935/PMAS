# PMAS Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# The backend refuses to start if JWT_SECRET or CORS_ORIGINS is missing or unsafe.

# Database (Supabase, Render, or local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/pmas

# JWT Security — REQUIRED (startup fails without it)
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRY_HOURS=24

# CORS — REQUIRED: explicit origin allow-list, never "*"
# Production origin: https://kartik-h6.github.io
CORS_ORIGINS=http://localhost:5500,https://kartik-h6.github.io

# First-run admin bootstrap (creates the initial administrator if none exists)
ADMIN_PHONE=
ADMIN_PASSWORD=

# Server
HOST=0.0.0.0
PORT=8000
